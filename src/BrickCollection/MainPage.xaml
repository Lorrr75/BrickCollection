<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="BrickCollection.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto,*">
        <Label Grid.Row="0"
               Text="La Mia Collezione"
               FontSize="22"
               FontAttributes="Bold"
               Margin="15, 15, 15, 5" />
        <Label Grid.Row="0"
               x:Name="StatusLabel"
               Text="Caricamento..."
               FontSize="14"
               TextColor="Gray"
               Margin="15,0,15,10" />
        <CollectionView Grid.Row="2"
                        x:Name="SetsCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="80.*" RowDefinitions="Auto">
                        <Image Grid.Column="0"
                               Source="{Binding Image.ThumbnailURL}"
                               WidthRequest="70"
                               HeightRequest="70"
                               Aspect="AspectFill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                             Padding="10,0,0,0">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Number}" FontSize="12" TextColor="Gray"/>
                            <Label FontSize="12">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Year}" />
                                        <Span Text=" . " />
                                        <Span Text="{Binding Pieces}" />
                                        <Span Text=" pezzi" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Pieces}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>